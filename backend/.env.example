# Copie para .env e ajuste:  cp .env.example .env
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# OBRIGATÓRIO (mín. 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

DATABASE_FILE=./data/taskapp.db

# Origens liberadas no CORS (Expo Web roda na 8081)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Número de proxies reversos na frente da API (0 = acesso direto)
TRUST_PROXY=0
